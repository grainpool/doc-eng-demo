{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concord-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "589e5ae8d530ba18eb7066f3c8f55478",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "concord.otonieltrejo.com", "custom_domain": true }],
  "assets": {
    "directory": "../concord-web/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Phase 19 cleanup (security.md §8): hourly; closes PRs and deletes
  // concord/run-* branches older than 48h. Idempotent.
  "triggers": { "crons": ["17 * * * *"] },
  "queues": {
    // One producer (the API), one consumer (this worker's queue handler):
    // a run makes 5–15 model calls; consumers get 15 min of CPU
    // (research-findings.md §1).
    "producers": [{ "binding": "RUN_QUEUE", "queue": "concord-runs" }],
    "consumers": [
      { "queue": "concord-runs", "max_batch_size": 1, "max_retries": 1 }
    ]
  },
  "vars": {
    // Access verification targets (security.md §2). Not secrets. The
    // privileged surface additionally requires DEMO_ADMIN_ENABLED="true",
    // which this deployed config deliberately does NOT set (default-off).
    "ACCESS_TEAM_DOMAIN": "grainpool.cloudflareaccess.com",
    "ACCESS_AUD": "be136ff79ded93a44ad0b615f810999d6128adcfbf86112a2e9daab09b599278",
    // The ONLY Relay surface Concord touches (CONTRACTS-FROZEN.md §1).
    "RELAY_BASE_URL": "https://relay.otonieltrejo.com",
    // Phase 19: the estate repo the App is installed on. Not a secret —
    // the secrets (GITHUB_APP_ID, GITHUB_INSTALLATION_ID,
    // GITHUB_APP_PRIVATE_KEY) go in via `wrangler secret put` only.
    "GITHUB_REPO": "grainpool/doc-eng-demo-estate",
    "CONCORD_PUBLIC_URL": "https://concord.otonieltrejo.com"
  },
  "d1_databases": [
    {
      "binding": "concord_db",
      "database_name": "concord_db",
      "database_id": "37c7e62d-6ca4-4a51-b529-fef06cb358bb"
    }
  ]
}
