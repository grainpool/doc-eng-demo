{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concord-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "589e5ae8d530ba18eb7066f3c8f55478",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "concord.otonieltrejo.com", "custom_domain": true }],
  "assets": {
    "directory": "../concord-web/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.mdx"] }],
  "vars": {
    // The ONLY Relay surface Concord touches (CONTRACTS-FROZEN.md §1).
    "RELAY_BASE_URL": "https://relay.otonieltrejo.com"
  },
  "d1_databases": [
    {
      "binding": "concord_db",
      "database_name": "concord_db",
      "database_id": "37c7e62d-6ca4-4a51-b529-fef06cb358bb"
    }
  ]
}
