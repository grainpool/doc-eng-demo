{
  "name": "doc-eng-demo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "setup": "git submodule update --init --recursive && git config core.hooksPath .githooks",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "cli:introspect": "node scripts/capture-cli-introspection.mjs",
    "dev": "pnpm --filter relay-web dev",
    "deploy:relay": "pnpm --filter relay-web run deploy",
    "deploy:kernel": "pnpm --filter relay-web run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.0"
  }
}
